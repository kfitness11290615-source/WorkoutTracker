@page "/training"
@page "/training/{DateString}"
@using Microsoft.EntityFrameworkCore
@using WorkoutTracker.Data
@using WorkoutTracker.Models
@using WorkoutTracker.Services

<div class="training-page">
    <div class="header">
        <h2>@FormattedDate</h2>
        <div class="week-info">トレーニング記録</div>
    </div>

    @* === 追加済み種目ウィジェット一覧 === *@
    @if (ActiveExercises.Count == 0 && !ShowAddModal)
    {
        <div class="empty-state">
            <div class="empty-icon">🏋️</div>
            <p>右下の ＋ ボタンで種目を追加してください</p>
        </div>
    }

    @foreach (var widget in ActiveExercises)
    {
        <div class="exercise-widget @(widget.IsExpanded ? "expanded" : "")">
            @* ウィジェットヘッダー *@
            <div class="widget-header" @onclick="() => ToggleWidget(widget)">
                <div class="widget-title">
                    <span class="widget-bodypart">
                        @widget.Exercise.BodyPart?.Name 
                        @if (widget.Recommendation != null)
                        {
                            <span class="widget-week">・ Week @widget.Recommendation.CurrentWeek (@widget.Recommendation.WeekPurpose)</span>
                        }
                    </span>
                    <span class="widget-name">@widget.Exercise.Name</span>
                </div>
                <div class="widget-summary">
                    @if (widget.Records.Count > 0)
                    {
                        <span class="set-badge">@widget.Records.Count セット</span>
                    }
                    <span class="chevron @(widget.IsExpanded ? "up" : "down")">▸</span>
                </div>
            </div>

            @* ウィジェット展開時の内容 *@
            @if (widget.IsExpanded)
            {
                <div class="widget-body">
                    @* 参考情報 *@
                    @if (widget.Recommendation != null)
                    {
                        <div class="ref-row">
                        <div class="ref-item">
                            @if (widget.Records.Count > 0)
                            {
                                <span class="ref-label" style="color: #FFC107;">次セット参考</span>
                                <span class="ref-value" style="color: #FFC107;">@widget.DynamicRecommendedWeight kg (RPE @widget.Recommendation?.TargetRpe, @(string.IsNullOrWhiteSpace(widget.Recommendation?.RepRange) ? widget.Exercise.TargetRepRange : widget.Recommendation.RepRange) reps)</span>
                            }
                            else
                            {
                                <span class="ref-label">今回推奨</span>
                                <span class="ref-value">@widget.Recommendation?.RecommendedWeight kg (RPE @widget.Recommendation?.TargetRpe, @(string.IsNullOrWhiteSpace(widget.Recommendation?.RepRange) ? widget.Exercise.TargetRepRange : widget.Recommendation.RepRange) reps, @widget.Recommendation?.TargetSets sets)</span>
                            }
                        </div>
                    </div>
                    }
                    @if (widget.LastRecords.Count > 0)
                    {
                        <div class="ref-row last">
                            <div class="ref-item">
                                <div class="ref-header">
                                    <span class="ref-label">前回実績 (@widget.LastRecordDate)</span>
                                    <button type="button" class="history-link-btn" @onclick="() => OpenHistoryModal(widget.Exercise)">全履歴 📋</button>
                                </div>
                                @foreach (var prev in widget.LastRecords)
                                {
                                    <span class="ref-value">Set @prev.SetNumber: @prev.Weight kg × @prev.Rep rep (RPE @prev.Rpe)</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ref-row last ref-row-empty">
                            <div class="ref-item">
                                <div class="ref-header">
                                    <span class="ref-label-sub">過去の実績</span>
                                    <button type="button" class="history-link-btn" @onclick="() => OpenHistoryModal(widget.Exercise)">過去の履歴 📋</button>
                                </div>
                                <span class="ref-value-muted">前回実績はありません</span>
                            </div>
                        </div>
                    }

                    @* 記録済みセット *@
                    @if (widget.Records.Count > 0)
                    {
                        <div class="recorded-sets">
                            @foreach (var rec in widget.Records)
                            {
                                <div class="set-row">
                                    <span class="set-num">Set @rec.SetNumber</span>
                                    <span class="set-detail">@rec.Weight kg × @rec.Rep (RPE @rec.Rpe)</span>
                                    <button class="set-delete" @onclick="() => DeleteRecord(widget, rec.Id)">✕</button>
                                </div>
                            }
                        </div>
                    }

                    @* 入力フォーム *@
                    <div class="input-row">
                        <div class="input-group">
                            <label>重量</label>
                            <input type="number" step="@(widget.Exercise.WeightIncrement)" @bind="widget.NewWeight" class="compact-input" />
                        </div>
                        <div class="input-group">
                            <label>Rep</label>
                            <input type="number" step="1" @bind="widget.NewRep" class="compact-input" />
                        </div>
                        <div class="input-group">
                            <label>RPE</label>
                            <input type="number" step="0.5" @bind="widget.NewRpe" class="compact-input" />
                        </div>
                    </div>
                    <div class="widget-actions">
                        <button class="save-set-btn" @onclick="() => SaveRecord(widget)">セットを保存</button>
                        <button class="remove-widget-btn" @onclick="() => RemoveExerciseWidget(widget)">この種目を外す</button>
                    </div>
                </div>
            }
        </div>
    }

    @* === FAB（＋ボタン） === *@
    <button class="fab" @onclick="OpenAddModal">
        <span class="fab-icon">＋</span>
    </button>

    @* === 種目追加モーダル === *@
    @if (ShowAddModal)
    {
        <div class="modal-overlay" @onclick="CloseAddModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                @if (AddStep == 1)
                {
                    @* STEP 1: 部位選択 *@
                    <h3>部位を選択</h3>
                    <div class="modal-grid">
                        @foreach (var bp in BodyParts)
                        {
                            <button class="modal-card" @onclick="() => SelectBodyPartForAdd(bp.Id)">
                                @bp.Name
                            </button>
                        }
                    </div>
                }
                else if (AddStep == 2)
                {
                    @* STEP 2: 種目選択 *@
                    <div class="modal-header-row">
                        <button class="back-btn" @onclick="() => { AddStep = 1; }">← 戻る</button>
                        <h3>@SelectedBodyPartForAdd?.Name の種目</h3>
                    </div>
                    <div class="modal-list">
                        @foreach (var ex in ModalFilteredExercises)
                        {
                            var alreadyAdded = ActiveExercises.Any(a => a.Exercise.Id == ex.Id);
                            <button class="modal-list-item @(alreadyAdded ? "disabled" : "")" 
                                    @onclick="() => AddExerciseToSession(ex)" 
                                    disabled="@alreadyAdded">
                                <span>@ex.Name</span>
                                @if (alreadyAdded)
                                {
                                    <span class="already-badge">追加済</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* === 過去履歴モーダル === *@
    @if (ShowHistoryModal && HistoryExercise != null)
    {
        <div class="modal-overlay" @onclick="CloseHistoryModal">
            <div class="modal-content history-modal-content" @onclick:stopPropagation="true">
                <div class="history-modal-header">
                    <div class="history-title-block">
                        <span class="widget-bodypart">@HistoryExercise.BodyPart?.Name</span>
                        <h3 class="history-modal-title">@HistoryExercise.Name の履歴</h3>
                    </div>
                    <button type="button" class="history-close-btn" @onclick="CloseHistoryModal">✕</button>
                </div>

                @if (IsLoadingHistory)
                {
                    <div class="history-loading">
                        <div class="spinner"></div>
                        <p>履歴を読み込み中...</p>
                    </div>
                }
                else if (HistoryGroups.Count == 0)
                {
                    <div class="history-empty">
                        <p>過去のトレーニング記録はありません。</p>
                    </div>
                }
                else
                {
                    <div class="history-list">
                        @foreach (var group in HistoryGroups)
                        {
                            <div class="history-card">
                                <div class="history-card-header">
                                    <div class="history-date-info">
                                        <span class="history-date">@group.Date.ToString("yyyy/MM/dd (ddd)")</span>
                                        @if (group.WeekInCycle > 0)
                                        {
                                            <span class="history-week">Week @group.WeekInCycle@(!string.IsNullOrEmpty(group.WeekPurpose) ? $" ({group.WeekPurpose})" : "")</span>
                                        }
                                    </div>
                                    @if (group.BestE1RM > 0)
                                    {
                                        <span class="history-e1rm-badge">Best e1RM: @group.BestE1RM.ToString("F1") kg</span>
                                    }
                                </div>
                                <div class="history-sets">
                                    @foreach (var rec in group.Records)
                                    {
                                        <div class="history-set-row">
                                            <span class="history-set-num">Set @rec.SetNumber</span>
                                            <span class="history-set-val">@rec.Weight kg × @rec.Rep rep</span>
                                            <span class="history-set-rpe">RPE @rec.Rpe</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
