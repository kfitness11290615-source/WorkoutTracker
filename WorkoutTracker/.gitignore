## =========================================================================
## .gitignore for WorkoutTracker (.NET 9 Blazor / SQLite)
## =========================================================================

# Sensitive Configuration
appsettings*.json
!appsettings.Example.json
*.secrets.json

# SQLite Database & Backups
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
Backups/
*.backup
*.bak

# .NET Build Artifacts
bin/
obj/
publish/
out/
*.dll
*.exe
*.pdb
*.cache
*.deps.json
*.runtimeconfig.json

# IDEs
.vs/
.vscode/
*.user
*.userosscache
*.sln.docstates
*.suo

# OS Files & Logs
*.log
Thumbs.db
Desktop.ini
.DS_Store
